# Copy to <repo>/agents-info/translator/.env (or put the vars in the repo's .env).
# Make sure that path is gitignored. Never commit a real key.

# Drafts, reviews and compare go through OpenRouter: https://openrouter.ai/keys
# Set a credit limit on the key; a full compare of 7 models over 3 files costs about $1.
OPENROUTER_API_KEY=

# Optional: only for `translate --model deepl`. Free tier is 500K chars/month: https://www.deepl.com/your-account/keys
DEEPL_API_KEY=
